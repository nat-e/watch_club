      "up": "CREATE OR REPLACE FUNCTION delete_parent_activity_feed_event()\nRETURNS TRIGGER LANGUAGE plpgsql AS $$\nBEGIN\n  DELETE FROM activity_feed_events WHERE id = OLD.id;\n  RETURN OLD;\nEND;\n$$\n"
