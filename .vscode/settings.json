{
	"[css]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[elixir]": {
		"editor.defaultFormatter": "ExpertLSP.expert"
	},
	"[javascript]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[phoenix-heex]": {
		"editor.defaultFormatter": "ExpertLSP.expert"
	},
	"[tailwindcss]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"editor.quickSuggestions": {
		"strings": "on"
	},
	"elixir.credo.configurationFile": ".credo.exs",
	"elixir.credo.credoConfiguration": "default",
	"elixir.credo.enableDebug": true,
	"elixir.credo.lintEverything": false,
	"elixir.credo.strictMode": true,
	"emmet.includeLanguages": {
		"phoenix-heex": "html",
		// "elixir": "html",
		"html-eex": "html"
	},
	"expert.server.nightly": true,
	// "expert.server.logLevel": "warning",
	// "expert.server.fileLogLevel": "info",
	// "expert.trace.server": "off",
	"files.associations": {
		"*.css": "tailwindcss"
	},
	"files.exclude": {
		"**/node_modules": true,
		"**/deps/**": true,
		"**/_build/**": true
	},
	"files.readonlyInclude": {
		"**/mise.lock": true,
		"**/.git": true,
		"**/deps/**": true,
		"**/_build/**": true,
		"**/priv/static/assets/**": true
	},
	"search.exclude": {
		"**/mise.lock": true,
		"**/mix.lock": true
	},
	"tailwindCSS.experimental.classRegex": [
		[
			"class[:=]\\s*\"([^\"]*)\""
		],
		[
			"~H\"\"\"([\\s\\S]*?)\"\"\"",
			"class[:=]\\s*\"([^\"]*)\""
		]
	],
	"tailwindCSS.includeLanguages": {
		"phoenix-heex": "html",
		"elixir": "html"
	}
}
