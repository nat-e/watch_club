{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT u.id, u.username, u.locale, u.audio_language, u.subtitle_language,\n            u.languages_without_subtitles, u.is_instance_administrator\n        FROM sessions s\n        JOIN users u ON u.id = s.user_id\n        WHERE s.token_hash = $1 AND s.expires_at > now()\n        ",
