{
  "db_name": "PostgreSQL",
  "query": "\n        UPDATE jobs\n        SET state = 'executing', attempt = attempt + 1, attempted_at = now()\n        WHERE id IN (\n            SELECT id\n            FROM jobs\n            WHERE queue = $1 AND state = 'available' AND run_at <= now()\n            ORDER BY priority, run_at, id\n            LIMIT $2\n            FOR UPDATE SKIP LOCKED\n        )\n        RETURNING id, kind, args, attempt, max_attempts\n        ",
