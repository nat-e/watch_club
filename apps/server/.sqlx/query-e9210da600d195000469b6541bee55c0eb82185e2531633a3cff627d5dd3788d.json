  "query": "\n        SELECT\n            queue AS \"queue: String\",\n            count(*) AS \"count!\",\n            extract(epoch FROM now() - min(run_at))::float8 AS \"oldest_age!\"\n        FROM jobs\n        WHERE state = 'available' AND run_at <= now()\n        GROUP BY queue\n        ",
