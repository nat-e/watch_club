  "db_name": "PostgreSQL",
  "query": "\n        SELECT m.id, m.group_number, m.number, l.title, l.overview, m.image, m.release_date,\n            m.runtime_seconds\n        FROM media m\n        JOIN media_localizations l ON l.media_id = m.id AND l.locale = $2\n        WHERE m.content_id = $1\n        ORDER BY m.group_number, m.number\n        ",
