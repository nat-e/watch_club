# Copy to .env, which mise loads (see mise.toml)

# The app's database, which the SQLx macros also read at compile time
DATABASE_URL=postgres://postgres:postgres@localhost:5433/watch_club
# The port the server listens on
PORT=4100
# The port of the web app's dev server, which forwards API calls to the server, and the URL to open
WEB_PORT=4101
APP_URL=http://localhost:4101
# The port of Expo's dev server, which also forwards API calls to the server
RCT_METRO_PORT=4102
# The API Read Access Token of your TMDB account, at https://www.themoviedb.org/settings/api
TMDB_API_TOKEN=
# The API token of your Hardcover account, at https://hardcover.app/account/api
HARDCOVER_API_TOKEN=
# Optional: the key the server encrypts the secrets it stores with, such as the API keys of Radarr,
# Sonarr and Sportarr: 32 random bytes in base64, from `openssl rand -base64 32`. Without it, the
# server uses a key built into its code
# ENCRYPTION_KEY=
# Optional: the name the apps show for your instance, up to 30 characters. WatchClub by default
# INSTANCE_NAME=

# Optional: send the server's traces, metrics and logs to an OTLP endpoint, and errors to Sentry.
# See docs/observability.md
# OTEL_TRACES_EXPORTER=otlp
# OTEL_METRICS_EXPORTER=otlp
# OTEL_LOGS_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# SENTRY_DSN=
# SENTRY_WEB_DSN=
# SENTRY_MOBILE_DSN=
