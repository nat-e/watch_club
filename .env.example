# Copy this file to .env and fill in the values below.
#   cp .env.example .env

#
# Watch Club configuration
#

# URL to reach the database.
WC_DATABASE_URL=ecto://watch_club:securepassword@postgres/watch_club

# The version of the Watch Club Docker image: `latest` for the newest release,
# a release such as `1.2.3`, or `edge` for the latest unreleased changes
WATCH_CLUB_VERSION=latest

# The secret with which password and session tokens will be encrypted.
# Generate something secure. You can use `openssl rand -base64 64` or similar
WC_SECRET=yoursecret

# The URL visitors use to reach the app, without a path, e.g.
# https://watch.example.com behind a reverse proxy that handles HTTPS
WC_URL=http://localhost:4000
# The port the app listens on
WC_PORT=4000


# The format of the logs, either `text` (default) or `json`
WC_LOG_FORMAT=text
# The minimum level of the logs, one of `debug`, `info` (default), `warning`, `error`
WC_LOG_LEVEL=info

# Optional. Reports errors to Sentry, or a Sentry-compatible tool like
# GlitchTip or Bugsink. Leave empty to disable.
WC_SENTRY_DSN=
# Optional. Also sends the logs at this level and above to Sentry, one of
# `debug`, `info`, `warning`, `error`. Leave empty to not send logs.
WC_SENTRY_LOG_LEVEL=

# Optional. Export each signal to your own OpenTelemetry endpoint.
# Set a signal to `otlp` to enable it; `none` disables it.
OTEL_TRACES_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
# HTTP/protobuf uses a base URL; /v1/traces, /v1/metrics and /v1/logs are appended.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Optional resource overrides, e.g. deployment.environment.name=production
OTEL_SERVICE_NAME=watch_club
OTEL_RESOURCE_ATTRIBUTES=

# The API key for the TMDB API
# Create a read access token at https://www.themoviedb.org/settings/api
WC_TMDB_API_KEY=eY...

# Writable directory for generated assets (trickplay sprite sheets, etc.).
WC_APP_DATA=/data
