# Copy this file to .env and fill in the values below.
#   cp .env.example .env

#
# Watch Club configuration
#

# URL to reach the database.
WC_DATABASE_URL=ecto://watch_club:securepassword@postgres/watch_club

# The version of the Watch Club Docker image
WATCH_CLUB_VERSION=latest

# The secret with which password and session tokens will be encrypted.
# Generate something secure. You can use `openssl rand -base64 64` or similar
WC_SECRET=yoursecret

# The public network configuration of the app
WC_SCHEME=http
WC_HOST=localhost
WC_PORT=4000

# The API key for the TMDB API
# Create a read access token at https://www.themoviedb.org/settings/api
WC_TMDB_API_KEY=eY...

# Writable directory for generated assets (trickplay sprite sheets, etc.).
WC_APP_DATA=/data