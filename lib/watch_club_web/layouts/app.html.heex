<div class="min-h-svh bg-background text-text [--wc-sidebar-width:16rem]">
  <.live_component
    id="sidebar"
    module={WatchClubWeb.Live.Nav.SidebarComponent}
    current_url={@current_url}
    current_user={@current_user}
  />

  <main class="relative min-h-svh md:pl-[var(--wc-sidebar-width)]">
    <div
      :if={@backdrop != []}
      class="absolute z-0 h-[400px] w-full xl:h-[500px] bg-emerald-400"
    >
      {render_slot(@backdrop)}
      <div class="to-background from-background/50 absolute inset-0 bg-linear-to-b"></div>
    </div>
    <.live_component
      id="nabar"
      module={WatchClubWeb.Live.Nav.NavbarComponent}
      current_url={@current_url}
      current_user={@current_user}
    />
    <div class={["flex flex-col p-4 gap-6 z-1", @class]}>
      {render_slot(@inner_block)}
    </div>
  </main>
</div>

<.flash flash={@flash} />
