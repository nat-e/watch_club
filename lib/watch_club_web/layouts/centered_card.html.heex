<div class="relative grid min-h-svh place-items-center bg-gray-900 px-4 py-14">
  <div class="relative z-10 w-full max-w-sm sm:max-w-md">
    <div class="flex flex-col gap-2">
      <.card class="w-full border-0 bg-card/50 backdrop-blur-sm">
        <.dialog>
          <:title :if={@title} class="flex flex-row items-center gap-2 text-xl">
            {@title}
          </:title>
          <div class={["flex flex-col gap-6", @class]}>
            {render_slot(@inner_block)}
          </div>
        </.dialog>
      </.card>
    </div>
  </div>
</div>

<.flash flash={@flash} />
