<div class="relative grid min-h-svh place-items-center bg-gray-900 px-4 py-14">
  <div class="relative z-10 w-full max-w-sm sm:max-w-md">
    <section class="flex w-full flex-col gap-6 rounded-xl bg-card/50 p-6 text-card-foreground shadow-xs ring-1 ring-foreground/10 backdrop-blur-sm">
      <h1 :if={@title} class="flex flex-row items-center gap-2 font-heading text-xl font-medium">
        {@title}
      </h1>
      <div class={["flex flex-col gap-6", @class]}>
        {render_slot(@inner_block)}
      </div>
    </section>
  </div>
</div>

<.flash flash={@flash} />
