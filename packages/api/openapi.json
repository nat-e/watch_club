        "properties": {
          "next_page": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "The number of the next page, or null on the last one",
            "minimum": 2
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchResult"
            },
            "description": "The results, most relevant first. Only the last page can have none, unless TMDB's pages\nin between have only people"
          }
        }
      },
      "TrackLanguage": {
        "type": "string",
        "description": "A language a User can choose for audio and subtitles, as its ISO 639-1 code.",
        "enum": [
          "en",
          "fr"
        ]
      },
      "UserId": {
        "type": "string",
        "format": "uuid",
        "description": "The unique ID of a User."
      },
