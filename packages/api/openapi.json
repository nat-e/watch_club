{
  "openapi": "3.1.0",
  "info": {
    "title": "WatchClub",
    "description": "A self-hosted media server for small private groups",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/auth/login": {
      "post": {
        "summary": "Signs the browser in with a session cookie.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Signed in with the session cookie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "The request was malformed or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "message"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "invalid_request"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "description": "The failure in English, for developers rather than users"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Wrong username or password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody_LoginRequestError"
                }
              }
            }
          },
          "500": {
            "description": "Something went wrong. Try again later.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "message"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "internal_error"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "description": "The failure in English, for developers rather than users"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login/token": {
      "post": {
        "summary": "Signs a mobile app in, and returns the token it sends with every request.",
        "operationId": "login_token",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppSession"
                }
              }
            }
          },
          "400": {
            "description": "The request was malformed or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "message"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "invalid_request"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "description": "The failure in English, for developers rather than users"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Wrong username or password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody_LoginRequestError"
                }
              }
            }
          },
          "500": {
            "description": "Something went wrong. Try again later.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "message"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "internal_error"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "description": "The failure in English, for developers rather than users"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "summary": "Signs out the browser or app the request comes from. Succeeds when it's signed out already.",
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Signed out, and the session cookie removed"
          },
          "500": {
            "description": "Something went wrong. Try again later.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "message"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "internal_error"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "description": "The failure in English, for developers rather than users"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {},
          {
            "session_cookie": []
          },
          {
            "session_token": []
          }
        ]
      }
    },
    "/api/health": {
      "get": {
        "summary": "Checks that the server reaches its database.",
        "operationId": "check_health",
        "responses": {
          "200": {
            "description": "The server works"
          },
          "500": {
            "description": "Something went wrong. Try again later.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "message"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "internal_error"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "description": "The failure in English, for developers rather than users"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "The server can't reach its database"
          }
        }
      }
    },
    "/api/instance": {
      "get": {
        "summary": "Returns the information apps need about the WatchClub instance before signing in.",
        "operationId": "get_instance",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Instance"
                }
              }
            }
          },
          "500": {
            "description": "Something went wrong. Try again later.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "message"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "internal_error"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "description": "The failure in English, for developers rather than users"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/instance/administrator": {
      "post": {
        "summary": "Creates the Instance Administrator and signs the browser in as them.",
        "operationId": "create_instance_administrator",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewInstanceAdministrator"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created, and signed in with the session cookie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "The request was malformed or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "message"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "invalid_request"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "description": "The failure in English, for developers rather than users"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "WatchClub already has its Instance Administrator",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody_CreateInstanceAdministratorRequestError"
                }
              }
            }
          },
          "422": {
            "description": "The username or password breaks the rules",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody_CreateInstanceAdministratorRequestError"
                }
              }
            }
          },
          "500": {
            "description": "Something went wrong. Try again later.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "message"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "internal_error"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "description": "The failure in English, for developers rather than users"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "summary": "Returns the signed-in User.",
        "operationId": "get_current_user",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "description": "The request was not authorized.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "message"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "unauthorized"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "description": "The failure in English, for developers rather than users"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Something went wrong. Try again later.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "message"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "internal_error"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "description": "The failure in English, for developers rather than users"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "session_cookie": []
          },
          {
            "session_token": []
          }
        ]
      }
    },
    "/api/me/preferences": {
      "put": {
        "summary": "Saves the signed-in User's preferences, and returns the User with them.",
        "operationId": "update_preferences",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserPreferences"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "The request was malformed or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "message"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "invalid_request"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "description": "The failure in English, for developers rather than users"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "The request was not authorized.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "message"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "unauthorized"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "description": "The failure in English, for developers rather than users"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Something went wrong. Try again later.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "message"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "internal_error"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "description": "The failure in English, for developers rather than users"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "session_cookie": []
          },
          {
            "session_token": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AppSession": {
        "type": "object",
        "description": "The session token a mobile app signed in with, and its User.",
        "required": [
          "token",
          "user"
        ],
        "properties": {
          "token": {
            "type": "string",
            "description": "The token to send as `Authorization: Bearer <token>`"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "CreateInstanceAdministratorRequestError": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "invalid_fields"
                ]
              },
              "password": {
                "$ref": "#/components/schemas/PasswordProblem"
              },
              "username": {
                "$ref": "#/components/schemas/UsernameProblem"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "instance_administrator_already_exists"
                ]
              }
            }
          }
        ],
        "description": "The failures of a request to create the Instance Administrator."
      },
      "Credentials": {
        "type": "object",
        "description": "A username and password to sign in with.",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "password": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "ErrorBody_CreateInstanceAdministratorRequestError": {
        "allOf": [
          {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "code"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "enum": [
                      "invalid_fields"
                    ]
                  },
                  "password": {
                    "$ref": "#/components/schemas/PasswordProblem"
                  },
                  "username": {
                    "$ref": "#/components/schemas/UsernameProblem"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "code"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "enum": [
                      "instance_administrator_already_exists"
                    ]
                  }
                }
              }
            ],
            "description": "The failures of a request to create the Instance Administrator."
          },
          {
            "type": "object",
            "required": [
              "message"
            ],
            "properties": {
              "message": {
                "type": "string",
                "description": "The failure in English, for developers rather than users"
              }
            }
          }
        ],
        "description": "The body of every error response: the error's `code` and details, and a message."
      },
      "ErrorBody_LoginRequestError": {
        "allOf": [
          {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "code"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "enum": [
                      "wrong_credentials"
                    ]
                  }
                }
              }
            ],
            "description": "The failures of a request to sign in."
          },
          {
            "type": "object",
            "required": [
              "message"
            ],
            "properties": {
              "message": {
                "type": "string",
                "description": "The failure in English, for developers rather than users"
              }
            }
          }
        ],
        "description": "The body of every error response: the error's `code` and details, and a message."
      },
      "Instance": {
        "type": "object",
        "description": "The information apps need about the WatchClub instance before signing in.",
        "required": [
          "version",
          "needs_setup",
          "web_sentry_dsn"
        ],
        "properties": {
          "needs_setup": {
            "type": "boolean",
            "description": "Whether Setup still has to create the Instance Administrator"
          },
          "version": {
            "type": "string",
            "description": "The server's version"
          },
          "web_sentry_dsn": {
            "type": [
              "string",
              "null"
            ],
            "description": "The Sentry DSN the web app reports its errors to, or null when it reports none"
          }
        }
      },
      "Locale": {
        "type": "string",
        "description": "A language and country preference.",
        "enum": [
          "en-US",
          "fr-FR"
        ]
      },
      "LoginRequestError": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "wrong_credentials"
                ]
              }
            }
          }
        ],
        "description": "The failures of a request to sign in."
      },
      "NewInstanceAdministrator": {
        "type": "object",
        "description": "The Instance Administrator that Setup creates.",
        "required": [
          "username",
          "password",
          "locale"
        ],
        "properties": {
          "locale": {
            "$ref": "#/components/schemas/Locale",
            "description": "The Locale of the visitor's browser"
          },
          "password": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "PasswordProblem": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "missing"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "min",
              "code"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "too_short"
                ]
              },
              "min": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        ],
        "description": "Potential errors when parsing Passwords"
      },
      "User": {
        "type": "object",
        "description": "A person with a WatchClub account.",
        "required": [
          "id",
          "username",
          "locale",
          "is_instance_administrator"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/UserId"
          },
          "is_instance_administrator": {
            "type": "boolean"
          },
          "locale": {
            "$ref": "#/components/schemas/Locale",
            "description": "The language and country WatchClub uses for them"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "UserId": {
        "type": "string",
        "format": "uuid",
        "description": "The unique ID of a User."
      },
      "UserPreferences": {
        "type": "object",
        "description": "A User's personal choices that shape their WatchClub experience.",
        "required": [
          "locale"
        ],
        "properties": {
          "locale": {
            "$ref": "#/components/schemas/Locale"
          }
        }
      },
      "UsernameProblem": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "missing"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "min",
              "code"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "too_short"
                ]
              },
              "min": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          {
            "type": "object",
            "required": [
              "max",
              "code"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "too_long"
                ]
              },
              "max": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          {
            "type": "object",
            "description": "Characters other than lowercase letters, digits and underscores",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "invalid_characters"
                ]
              }
            }
          }
        ],
        "description": "Potential errors when parsing Usernames"
      }
    },
    "securitySchemes": {
      "session_cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session"
      },
      "session_token": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
