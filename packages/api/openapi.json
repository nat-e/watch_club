              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "UsernameProblem": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "missing"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "min",
              "code"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "too_short"
                ]
              },
              "min": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          {
            "type": "object",
            "required": [
              "max",
              "code"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "too_long"
                ]
              },
              "max": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          {
            "type": "object",
            "description": "Characters other than lowercase letters, digits and underscores",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "invalid_characters"
                ]
              }
            }
          }
        ],
        "description": "Potential errors when parsing Usernames"
      }
