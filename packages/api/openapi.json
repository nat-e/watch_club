    "/api/search": {
      "get": {
        "summary": "Returns a page of the Movies and TV Shows whose title matches the query, most relevant first,\nwith their texts in the signed-in User's language.",
        "operationId": "search",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "description": "The words to look for in titles. A blank query matches nothing",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "The page to return, from 1, the default: the previous page's `next_page`",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResults"
                }
              }
            }
