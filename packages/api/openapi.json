  "components": {
    "schemas": {
      "AppSession": {
        "type": "object",
        "description": "The session token a mobile app signed in with, and its User.",
        "required": [
          "token",
          "user"
        ],
        "properties": {
          "token": {
            "type": "string",
            "description": "The token to send as `Authorization: Bearer <token>`"
          },
          "user": {
            "$ref": "#/components/schemas/CurrentUser"
          }
        }
      },
      "AudioLanguage": {
        "type": "string",
        "description": "The language a User wants to hear: the Content's original language, or a Track Language.",
        "enum": [
          "original",
          "en",
          "fr"
        ]
      },
      "Content": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ContentId"
          },
          {
            "type": "object",
            "required": [
              "title"
            ],
            "properties": {
              "title": {
                "type": "string"
              }
            }
          }
        ],
        "description": "A Content, with its title in the User's language."
      },
      "ContentId": {
        "type": "object",
        "description": "What identifies a Content: its type and its TMDB ID. A Movie and a TV Show can have the same\nTMDB ID.",
        "required": [
          "content_type",
          "tmdb_id"
        ],
        "properties": {
          "content_type": {
            "$ref": "#/components/schemas/ContentType"
          },
          "tmdb_id": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "ContentType": {
        "type": "string",
        "description": "The type of a Content.",
        "enum": [
          "movie",
          "tv_show"
        ]
      },
      "CreateInstanceAdministratorRequestError": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "invalid_fields"
                ]
              },
              "password": {
                "$ref": "#/components/schemas/PasswordProblem"
              },
              "username": {
                "$ref": "#/components/schemas/UsernameProblem"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "instance_administrator_already_exists"
                ]
              }
            }
          }
        ],
        "description": "The failures of a request to create the Instance Administrator."
      },
      "Credentials": {
        "type": "object",
        "description": "A username and password to sign in with.",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "password": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "CurrentUser": {
        "type": "object",
        "description": "The signed-in User, including what only this User can see: the Instance Administrator status\nand the User Preferences.",
        "required": [
          "id",
          "username",
          "is_instance_administrator",
          "preferences"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/UserId"
          },
          "is_instance_administrator": {
            "type": "boolean"
          },
          "preferences": {
            "$ref": "#/components/schemas/UserPreferences"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "ErrorBody_CreateInstanceAdministratorRequestError": {
        "allOf": [
          {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "code"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "enum": [
                      "invalid_fields"
                    ]
                  },
                  "password": {
                    "$ref": "#/components/schemas/PasswordProblem"
                  },
                  "username": {
                    "$ref": "#/components/schemas/UsernameProblem"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "code"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "enum": [
                      "instance_administrator_already_exists"
                    ]
                  }
                }
              }
            ],
            "description": "The failures of a request to create the Instance Administrator."
          },
          {
            "type": "object",
            "required": [
              "message"
            ],
            "properties": {
              "message": {
                "type": "string",
                "description": "The failure in English, for developers rather than users"
              }
            }
          }
        ],
        "description": "The body of every error response: the error's `code` and details, and a message."
      },
      "ErrorBody_GetContentRequestError": {
        "allOf": [
          {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "code"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "enum": [
                      "not_found"
                    ]
                  }
                }
              }
            ],
            "description": "The failures of a request for a Content."
          },
          {
            "type": "object",
            "required": [
              "message"
            ],
            "properties": {
              "message": {
                "type": "string",
                "description": "The failure in English, for developers rather than users"
              }
            }
          }
        ],
        "description": "The body of every error response: the error's `code` and details, and a message."
      },
      "ErrorBody_LoginRequestError": {
        "allOf": [
          {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "code"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "enum": [
                      "wrong_credentials"
                    ]
                  }
                }
              }
            ],
            "description": "The failures of a request to sign in."
          },
          {
            "type": "object",
            "required": [
              "message"
            ],
            "properties": {
              "message": {
                "type": "string",
                "description": "The failure in English, for developers rather than users"
              }
            }
          }
        ],
        "description": "The body of every error response: the error's `code` and details, and a message."
      },
      "GetContentRequestError": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "not_found"
                ]
              }
            }
          }
        ],
        "description": "The failures of a request for a Content."
      },
      "Instance": {
        "type": "object",
        "description": "The information apps need about the WatchClub instance before signing in.",
        "required": [
          "version",
          "needs_setup",
          "web_sentry_dsn",
          "mobile_sentry_dsn",
          "sentry_environment"
        ],
        "properties": {
          "mobile_sentry_dsn": {
            "type": [
              "string",
              "null"
            ],
            "description": "The Sentry DSN the mobile apps report their crashes and errors to, or null when they report\nnone"
          },
          "needs_setup": {
            "type": "boolean",
            "description": "Whether Setup still has to create the Instance Administrator"
          },
          "sentry_environment": {
            "type": "string",
            "description": "The environment the apps' Sentry reports name, as the server's do, such as `production`"
          },
          "version": {
            "type": "string",
            "description": "The server's version"
          },
          "web_sentry_dsn": {
            "type": [
              "string",
              "null"
            ],
            "description": "The Sentry DSN the web app reports its errors to, or null when it reports none"
          }
        }
      },
      "Locale": {
        "type": "string",
        "description": "A language and country preference.",
        "enum": [
          "en-US",
          "fr-FR"
        ]
      },
      "LoginRequestError": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "wrong_credentials"
                ]
              }
            }
          }
        ],
        "description": "The failures of a request to sign in."
      },
      "NewInstanceAdministrator": {
        "type": "object",
        "description": "The Instance Administrator that Setup creates.",
        "required": [
          "username",
          "password",
          "locale"
        ],
        "properties": {
          "locale": {
            "$ref": "#/components/schemas/Locale",
            "description": "The Locale of the visitor's browser"
          },
          "password": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "PasswordProblem": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "missing"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "min",
              "code"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "too_short"
                ]
              },
              "min": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        ],
        "description": "Potential errors when parsing Passwords"
      },
      "SearchResult": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ContentId"
          },
          {
            "type": "object",
            "required": [
              "title",
              "year",
              "overview",
              "poster_path"
            ],
            "properties": {
              "overview": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "poster_path": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The path of its poster on TMDB's image server"
              },
              "title": {
                "type": "string"
              },
              "year": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "int32",
                "description": "The year of its release, or of its first episode, when TMDB knows it"
              }
            }
          }
        ],
        "description": "A Movie or a TV Show that matches a search, with its texts in the User's language."
      },
      "SearchResults": {
        "type": "object",
        "description": "A page of a search's results.",
