    "/api/contents/{content_type}/{tmdb_id}": {
      "get": {
        "summary": "Returns the Content, with its title in the signed-in User's language.",
        "operationId": "get_content",
        "parameters": [
          {
            "name": "content_type",
            "in": "path",
            "description": "The Content's type",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ContentType"
            }
          },
          {
            "name": "tmdb_id",
            "in": "path",
            "description": "The Content's TMDB ID",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Content"
                }
              }
            }
          },
          "400": {
            "description": "The request was malformed or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "message"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "invalid_request"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "description": "The failure in English, for developers rather than users"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "The request was not authorized.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "message"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "unauthorized"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "description": "The failure in English, for developers rather than users"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "TMDB has no such Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody_GetContentRequestError"
                }
              }
            }
          },
          "500": {
            "description": "Something went wrong. Try again later.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "message"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "internal_error"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "description": "The failure in English, for developers rather than users"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "session_cookie": []
          },
          {
            "session_token": []
          }
        ]
      }
    },
