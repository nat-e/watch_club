{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended",
		":semanticCommits",
		":prHourlyLimitNone",
		":maintainLockFilesWeekly",
		"helpers:pinGitHubActionDigests",
		"customManagers:dockerfileVersions",
		"customManagers:biomeVersions",
		"customManagers:githubActionsVersions"
	],
	"customManagers": [
		{
			"customType": "regex",
			"description": "Versions in config/config.exs that follow a `# renovate:` comment, as in the Dockerfile",
			"managerFilePatterns": ["/^config/config\\.exs$/"],
			"matchStrings": [
				"# renovate: datasource=(?<datasource>[a-zA-Z0-9-._]+?) depName=(?<depName>[^\\s]+?)(?: packageName=(?<packageName>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?\\s+version: \"(?<currentValue>[^\"]+)\""
			]
		}
	],
	"schedule": ["* 0-5 * * 1"],
	"minimumReleaseAge": "7 days",
	"osvVulnerabilityAlerts": true,
	"platformAutomerge": false,
	"constraints": {
		"erlang": "^29"
	},
	"mise": {
		"lockFileMaintenance": {
			"enabled": false
		}
	},
	"packageRules": [
		{
			"description": "One weekly PR for all patch updates, merged by Renovate once CI passes",
			"matchUpdateTypes": ["patch"],
			"groupName": "patch dependencies",
			"groupSlug": "patch",
			"automerge": true
		},
		{
			"description": "One weekly PR for all minor updates, merged by hand",
			"matchUpdateTypes": ["minor"],
			"groupName": "minor dependencies",
			"groupSlug": "minor"
		},
		{
			"description": "Erlang and Elixir in mise.lock and in the Dockerfile move together. Debian joins them because the Dockerfile's builder image only exists for some Elixir, Erlang and Debian combinations",
			"matchDepNames": ["erlang", "elixir", "debian"],
			"groupName": "erlang, elixir and debian",
			"groupSlug": "erlang-elixir-debian"
		},
		{
			"description": "Each ash_authentication_phoenix major needs the matching ash_authentication major, so their majors move together",
			"matchDepNames": ["ash_authentication", "ash_authentication_phoenix"],
			"matchUpdateTypes": ["major"],
			"groupName": "ash_authentication",
			"groupSlug": "ash-authentication"
		},
		{
			"description": "Stay on the Elixir build for our OTP major. Update -otp-29 with the erlang constraint above",
			"matchManagers": ["mise"],
			"matchDepNames": ["elixir"],
			"allowedVersions": "/^\\d+\\.\\d+\\.\\d+-otp-29$/",
			"ignoreUnstable": false
		},
		{
			"description": "Biome's tags look like @biomejs/biome@2.4.13",
			"matchManagers": ["mise"],
			"matchDepNames": ["biome"],
			"extractVersion": "^@biomejs/biome@(?<version>.+)$"
		},
		{
			"description": "Biome in mise.toml and the biome.json schema move together",
			"matchDepNames": ["biome", "@biomejs/biome"],
			"groupName": "biome",
			"groupSlug": "biome"
		},
		{
			"description": "GitHub Actions and reusable workflows in one PR, merged by Renovate once CI passes",
			"matchManagers": ["github-actions"],
			"matchDepTypes": ["action", "workflow"],
			"groupName": "github actions",
			"groupSlug": "github-actions",
			"automerge": true
		},
		{
			"description": "Updates that change what runs in the published image are fixes, so release-please lists them and proposes a release",
			"matchManagers": ["mix"],
			"matchDepTypes": ["prod"],
			"semanticCommitType": "fix"
		},
		{
			"description": "Updates that change what runs in the published image are fixes, so release-please lists them and proposes a release",
			"matchFileNames": ["Dockerfile", "config/config.exs"],
			"semanticCommitType": "fix"
		},
		{
			"description": "ffmpeg comes from conda-forge, and the Docker image runs it, so its updates are fixes",
			"matchManagers": ["mise"],
			"matchPackageNames": ["ffmpeg"],
			"registryUrls": ["https://api.anaconda.org/package/conda-forge/"],
			"semanticCommitType": "fix"
		},
		{
			"description": "Debian packages: the deb datasource has no release dates, and Debian drops replaced versions",
			"matchDatasources": ["deb"],
			"minimumReleaseAge": null,
			"registryUrls": [
				"https://deb.debian.org/debian?suite=trixie&components=main&binaryArch=amd64",
				"https://deb.debian.org/debian?suite=trixie-updates&components=main&binaryArch=amd64",
				"https://security.debian.org/debian-security?suite=trixie-security&components=main&binaryArch=amd64"
			]
		}
	]
}
