# Copy this file to .env for local development
#   cp .env.example.dev .env

#
# Watch Club configuration
#

# URL to reach the database.
WC_DATABASE_URL=ecto://postgres:postgres@localhost/watch_club_dev

# The secret with which password and session tokens will be encrypted.
WC_SECRET=njSJCkt/QXSdzH9OqPHv8jYRdMQqoyH1ci2rewqHMl+ZZXSov0su8b6yuXs3b0HB

# The URL visitors use to reach the app, without a path, e.g.
# https://watch.example.com behind a reverse proxy that handles HTTPS
WC_URL=http://localhost:4000
# The port the app listens on
WC_PORT=4000

# The API key for the TMDB API
# Create a read access token at https://www.themoviedb.org/settings/api
WC_TMDB_API_KEY=ey...

# Writable directory for app data (trickplay, ...).
WC_APP_DATA=priv/app_data

# Logger
WC_LOG_LEVEL=debug
WC_LOG_FORMAT=text

# VPN settings for qbittorrent
VPN_SERVICE_PROVIDER=nordvpn
OPENVPN_USER=
OPENVPN_PASSWORD=